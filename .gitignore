# ─────────────────────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
vendor/

# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables & Credentials (NEVER commit secrets)
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env

# ─────────────────────────────────────────────────────────────────────────────
# Build & Distribution Artifacts
# ─────────────────────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
server/dist/
client/dist/
out/
bin/
obj/

# ─────────────────────────────────────────────────────────────────────────────
# Prisma Generated Clients & Engine Binaries
# ─────────────────────────────────────────────────────────────────────────────
server/src/generated/
prisma/generated/
server/prisma/v2-client/*.tmp*
server/prisma/v2-client/*.node.tmp*
server/prisma/v2-client/*.node
server/prisma/v2-client/*.so.node
server/prisma/v2-client/*.dll.node
server/prisma/v2-client/*.dylib.node

# ─────────────────────────────────────────────────────────────────────────────
# Runtime Uploads, Sessions & Logs
# ─────────────────────────────────────────────────────────────────────────────
server/uploads/
uploads/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
server/server_restart.log
server/server_runtime.log
server/whatsapp-sessions/

# ─────────────────────────────────────────────────────────────────────────────
# Temporary, Debug & One-Off Scratch Files
# ─────────────────────────────────────────────────────────────────────────────
temp/
tmp/
backups/
server/tmp/
server/scratch/
server/scratch_*.js
server/scratch_*.ts
server/debug_*.js
server/debug_*.ts
server/test_*.js
server/test_*.ts
server/create_table.js
server/create_notif_table.js
server/update_client_company.js
*.tmp
*.tmp*

# ─────────────────────────────────────────────────────────────────────────────
