generator client {
  provider = "prisma-client-js"
}

generator custom_client {
  provider = "prisma-client-js"
  output   = "./v2-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Auth & Users
model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password_hash String
  first_name    String
  last_name     String?
  role          Role       @default(SalesPerson)
  status        UserStatus @default(INVITED)
  is_active     Boolean    @default(true) // Deprecated in favor of status, keeping for backward compat temporarily
  joining_date  DateTime?

  // Performance Targets (Count-Based)
  revenue_target Int? @default(0)
  device_target  Int? @default(0)
  leads_target   Int? @default(0)

  // Daily SWAT Targets (Synced from Product/Service targets as a cache or fallback)
  calls_target        Int? @default(0)
  activities_target   Int? @default(0)
  q1_target           Int? @default(0)
  linkedin_target     Int? @default(0)
  demo_target         Int? @default(0)
  proposal_target     Int? @default(0)
  direct_visit_target Int? @default(0)

  company_id           Int?
  sbu_id               Int?
  reporting_manager_id Int?
  reset_token          String?
  reset_token_expiry   DateTime?

  // Gates the automated Daily Report cron — independent of `status`/`is_active`.
  // Default false: new users must be explicitly opted in.
  daily_report_enabled Boolean @default(false)

  company           Company? @relation(fields: [company_id], references: [id])
  sbu               SBU?     @relation(fields: [sbu_id], references: [id])
  reporting_manager User?    @relation("ReportingManager", fields: [reporting_manager_id], references: [id])
  subordinates      User[]   @relation("ReportingManager")

  managed_companies Company[] @relation("ManagerCompanies")

  cashflow_management_access    Boolean                      @default(false)
  cashflow_management_companies CashflowManagementCompany[]

  billing_forecast_management_access    Boolean                              @default(false)
  billing_forecast_management_companies BillingForecastManagementCompany[]

  daily_reports           DailyReport[] @relation("DailyReportUser")

  department_id  Int?
  department_rel Department? @relation(fields: [department_id], references: [id])
  department     String      @default("IM") // Keeping old field for compatibility, using _rel for master

  leads                Lead[]                  @relation("LeadOwner")
  created_leads        Lead[]                  @relation("LeadCreator")
  forecast_headers     ForecastHeader[]
  calls                CallLog[]
  activities           ActivityLog[]
  privileges           Privilege[]
  kra_entries          KraEntry[]
  call_trackers        CallTracker[]
  call_activity_logs   CallActivityLog[]
  pomodoro_sessions    PomodoroSession[]
  pricing_negotiations PricingNegotiationLog[]
  follow_up_logs       FollowUpLog[]

  milestone_payments_collected LeadMilestonePaymentHistory[]
  milestone_bant_poa_updates   LeadMilestoneBantPoaHistory[]
  billing_forecasts_added      BillingForecast[]

  swat_performances  SwatPerformance[]   @relation("UserSwatPerformance")
  product_targets    UserProductTarget[]
  lead_source_type_access UserLeadSourceType[]
  bulk_upload_staged BulkUploadStaging[]
  claimed_uploads    BulkUploadStaging[] @relation("ClaimedUploads")

  validated_enquiries    Enquiry[] @relation("EnquiryValidator")
  allocated_enquiries    Enquiry[] @relation("EnquiryAssignee")
  created_enquiries      Enquiry[] @relation("EnquiryCreator")
  enquiry_allocations    Enquiry[] @relation("EnquiryAllocatedTo")
  cashflow_trackers      CashflowTracker[] @relation("CashflowExecutive")

  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  weekly_reports WeeklyReport[] @relation("UserWeeklyReports")
  poas           PlanOfAction[] @relation("UserPOAs")
  partners       Partner[]      @relation("UserPartners")
  bant_answers   LeadBantAnswer[]

  @@map("user")
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum Salutation {
  Mr
  Mrs
  Ms
  Dr
}

enum Role {
  CEO
  SalesManager
  SalesPerson
}

model Privilege {
  id          Int     @id @default(autoincrement())
  user_id     Int
  module_name String
  can_add     Boolean @default(false)
  can_edit    Boolean @default(false)
  can_delete  Boolean @default(false)
  can_view    Boolean @default(false)

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, module_name])
  @@map("privilege")
}

model CashflowManagementCompany {
  id         Int      @id @default(autoincrement())
  user_id    Int
  company_id Int
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([user_id, company_id])
  @@map("cashflow_management_company")
}

model BillingForecastManagementCompany {
  id         Int      @id @default(autoincrement())
  user_id    Int
  company_id Int
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([user_id, company_id])
  @@map("billing_forecast_management_company")
}

model Department {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  is_active Boolean @default(true)
  users     User[]

  @@map("department")
}

// Masters
model Company {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  is_active Boolean   @default(true)
  report_recipient_email String?
  sbus      SBU[]
  users     User[]
  managers  User[]    @relation("ManagerCompanies")
  leads     Lead[]
  products  Product[]
  cashflow_managers CashflowManagementCompany[]
  billing_forecast_managers BillingForecastManagementCompany[]
  daily_reports DailyReport[]
  forecast_headers ForecastHeader[]

  @@map("company")
}

model SBU {
  id         Int     @id @default(autoincrement())
  name       String
  company_id Int
  is_active  Boolean @default(true)

  company Company @relation(fields: [company_id], references: [id])
  users   User[]
  leads   Lead[]

  @@map("sbu")
}

model JobTitle {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  is_active Boolean @default(true)
  leads     Lead[]

  @@map("jobtitle")
}

model LeadSource {
  id                  Int             @id @default(autoincrement())
  name                String          @unique
  is_active           Boolean         @default(true)
  lead_source_type_id Int?
  lead_source_type    LeadSourceType? @relation(fields: [lead_source_type_id], references: [id])
  leads               Lead[]
  sourced_leads       Lead[]          @relation("LeadSourcing")
  enquiries           Enquiry[]
  partners            Partner[]
  calls               CallTracker[]

  @@index([lead_source_type_id])
  @@map("leadsource")
}

model LeadSourceType {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  is_active    Boolean      @default(true)
  lead_sources LeadSource[]
  user_access  UserLeadSourceType[]

  @@map("leadsourcetype")
}

// Restricts a BDE's Lead Gen Summary to specific Lead Source Types
// (e.g. Selvam -> Direct + Reference only, Ramasamy -> Digital only).
// No rows for a user = unrestricted (sees every active Lead Source Type).
model UserLeadSourceType {
  id                  Int @id @default(autoincrement())
  user_id             Int
  lead_source_type_id Int

  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lead_source_type LeadSourceType @relation(fields: [lead_source_type_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([user_id, lead_source_type_id])
  @@map("userleadsourcetype")
}


model Industry {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique
  is_active            Boolean              @default(true)
  leads                Lead[]
  call_trackers        CallTracker[]
  bulk_upload_stagings BulkUploadStaging[]

  @@map("industry")
}

model Country {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  is_active Boolean   @default(true)
  states    State[]
  leads     Lead[]
  enquiries Enquiry[]

  @@map("country")
}

model State {
  id         Int     @id @default(autoincrement())
  name       String
  country_id Int
  is_active  Boolean @default(true)

  country   Country   @relation(fields: [country_id], references: [id])
  cities    City[]
  leads     Lead[]
  enquiries Enquiry[]

  @@map("state")
}

model City {
  id        Int     @id @default(autoincrement())
  name      String
  state_id  Int
  is_active Boolean @default(true)

  state     State     @relation(fields: [state_id], references: [id])
  leads     Lead[]
  enquiries Enquiry[]

  @@map("city")
}

model Product {
  id                    Int     @id @default(autoincrement())
  name                  String  @unique
  count_type            String?
  company_id            Int?
  is_active             Boolean @default(true)
  lead_multiplier_count Float   @default(1.0)

  // Degradation Rules (Days Based)
  q4_to_q3_days        Int @default(0)
  q3_to_q2_days        Int @default(0)
  q2_to_q1_days        Int @default(0)
  q1_to_nurturing_days Int @default(0)

  // Device Target Multipliers
  device_q4_multiplier Float @default(1.0)
  device_q3_multiplier Float @default(1.0)
  device_q2_multiplier Float @default(1.0)
  device_q1_multiplier Float @default(1.0)

  // Leads Target Multipliers
  lead_q4_multiplier Float @default(1.0)
  lead_q3_multiplier Float @default(1.0)
  lead_q2_multiplier Float @default(1.0)
  lead_q1_multiplier Float @default(1.0)

  company               Company?              @relation(fields: [company_id], references: [id])
  personas              Persona[]
  leads                 Lead[]
  call_trackers         CallTracker[]
  user_targets          UserProductTarget[]
  swat_performances     SwatPerformance[]
  enquiries             Enquiry[]
  partners              Partner[]             @relation("PartnerProduct")
  plan_of_actions       PlanOfAction[]        @relation("POAProduct")
  bulk_upload_stagings  BulkUploadStaging[]
  daily_report_products DailyReportProduct[]
  cashflow_trackers     CashflowTracker[]
  forecast_headers      ForecastHeader[]

  @@map("product")
}

model EitService {
  id                 Int     @id @default(autoincrement())
  name               String  @unique
  count_type         String?
  is_active          Boolean @default(true)
  lead_q1_multiplier Float   @default(1.0)

  personas      Persona[]
  leads         Lead[]        @relation("LeadEitService")
  call_trackers CallTracker[]

  @@map("eitservice")
}

model ImService {
  id                 Int     @id @default(autoincrement())
  name               String  @unique
  count_type         String?
  is_active          Boolean @default(true)
  lead_q1_multiplier Float   @default(1.0)

  personas      Persona[]
  leads         Lead[]        @relation("LeadImService")
  call_trackers CallTracker[]

  @@map("imservice")
}

model Persona {
  id                 Int     @id @default(autoincrement())
  name               String
  product_or_service String? // "Product", "EitService", "ImService"
  product_id         Int?
  eit_service_id     Int?
  im_service_id      Int?
  is_active          Boolean @default(true)

  product    Product?      @relation(fields: [product_id], references: [id])
  eitService EitService?   @relation(fields: [eit_service_id], references: [id])
  imService  ImService?    @relation(fields: [im_service_id], references: [id])
  leads      Lead[]
  contacts   LeadContact[]

  @@map("persona")
}

model Collateral {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  url       String?
  is_active Boolean @default(true)
  leads     Lead[]

  @@map("collateral")
}

model SalesStage {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  is_active      Boolean       @default(true)
  leads          Lead[]
  follow_up_logs FollowUpLog[]
  enquiries      Enquiry[]

  @@map("salesstage")
}

model UserProductTarget {
  id         Int @id @default(autoincrement())
  user_id    Int
  product_id Int

  sales_target        Int? @default(0)
  revenue_target      Int? @default(0)
  device_target       Int? @default(0)
  partner_target      Int? @default(0)
  leads_target        Int? @default(0)
  calls_target        Int? @default(0)
  digital_leads_target Int? @default(0)
  linkedin_target     Int? @default(0)
  direct_visit_target Int? @default(0)
  email_target                Int? @default(0)
  linkedin_connection_target  Int? @default(0)
  proposals_target            Int? @default(0)
  demos_target                Int? @default(0)
  activities_target            Int? @default(0)
  days                Int? @default(0)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, product_id])
  @@map("userproducttarget")
}


model Activity {
  id                  Int           @id @default(autoincrement())
  name                String        @unique
  is_active           Boolean       @default(true)
  leads_next          Lead[]        @relation("NextActivity")
  leads_followup      Lead[]        @relation("FollowUpActivity")
  follow_up_logs      FollowUpLog[] @relation("FollowUpActivityLog")
  follow_up_logs_next FollowUpLog[] @relation("FollowUpNextActivity")

  @@map("activity")
}

model Avatar {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  is_active Boolean       @default(true)
  leads     Lead[]
  contacts  LeadContact[]

  @@map("avatar")
}

// Lead Module
model Lead {
  id             Int         @id @default(autoincrement())
  // 1. Info
  created_by_id  Int
  sales_sbu_id   Int?
  lead_owner_id  Int?
  enquiry_date   DateTime?
  salutation     Salutation?
  first_name     String?
  last_name      String?
  company_name      String?
  company_id        Int?
  client_company_id Int?
  vertical_id       Int?
  job_title_id   Int?
  avatar_id      Int?
  lead_source_id Int?
  industry_id    Int?

  // 2. Address
  address         String?  @db.Text
  country_id      Int?
  state_id        Int?
  city_id         Int?
  pin_code        String?
  other_info      String?  @db.Text
  annual_turnover Decimal?
  mobile_number   String?
  whatsapp_number String?
  email           String?
  website         String?

  // 4. Sourcing
  product_or_service    String? // Product, EitService, ImService
  product_id            Int?
  project_name          String? @db.VarChar(255) // Project Name / Order Name
  eit_service_id        Int?
  im_service_id         Int?
  persona_id            Int?
  where_find_them_id    Int? // Lead Source
  telecalling_qualified Boolean @default(false)

  // 5. Qualification / Mgmt
  device_count      String?
  employee_count    String?
  vendor_count      String?
  branch_unit       String?
  license_count     String?
  custom_count_type String?
  requirement_desc  String? @db.Text
  pain_points       String? @db.Text
  pain_points_files String? @db.Text // JSON or comma separated URLs
  demo_completed    Boolean @default(false)
  pilot_provided    Boolean @default(false)

  // Section 5: Demo, Pilot & Authority Engagement
  demo_done_authority                      Boolean  @default(false)
  post_demo_feedback_sent                  Boolean  @default(false)
  post_demo_feedback_received              Boolean  @default(false)
  post_demo_feedback_file                  String?
  probing_discussion_authority             Boolean  @default(false)
  direct_visit_authority                   Boolean  @default(false)
  pilot_given                              Boolean  @default(false)
  mgmt_call_completed                      Boolean  @default(false)
  utilized_mgmt_urgency                    Boolean  @default(false)
  utilized_presales_timeline               Boolean  @default(false)
  authority_champion_influencer_identified Boolean  @default(false)
  competitor_details                       String?  @db.Text
  opportunities_values                     String?  @db.Text
  order_won_attachment                     String?
  order_value                              Decimal?
  sales_device                             Int?
  lead_score                               Int      @default(0) // Auto-calculated sum of 13 scoring criteria below
  cp_score                                 Int      @default(0) // Auto-calculated sum of 10 CP criteria from Section 8

  // Lead Qualification Score Card (13 criteria × 0-2 points = max 26)
  // A. Organization Needs (4 items)
  reduce_cost_score  Int     @default(0) // 0-2: Headcount, Maintenance, Time Save
  efficiency_score   Int     @default(0) // 0-2: Response time, service
  automation_score   Int     @default(0) // 0-2: Brand progressive, manual activities
  others_score       Int     @default(0) // 0-2: Dynamic score replacement for Compliance
  others_score_label String? // Custom label for the Others score (e.g. Compliance, Loan, etc.)
  compliance_score   Int     @default(0) // 0-2: Mandatory Certifications, Loans, etc.

  // B. BANT / Critical Qualification Factors (4 items)
  established_need_score Int @default(0) // 0-2: Client recognizes need
  urgency_score          Int @default(0) // 0-2: Defined timelines
  budget_allocated_score Int @default(0) // 0-2: Clear budgets allocated
  decision_maker_score   Int @default(0) // 0-2: Responsible person identified

  // C. Other Key Info (3 items)
  competition_score Int @default(0) // 0-2: No competition=2, Yes=0
  champion_score    Int @default(0) // 0-2: Champion within org/group
  influencer_score  Int @default(0) // 0-2: Influencer identified (internal/external)

  // D. Lead Source Details (2 items)
  lead_source_quality    Int @default(0) // 0-2: Quality of lead source
  decision_contact_score Int @default(0) // 0-2: Decision maker contact gathering

  // BANT (Yes/No with details)
  budget_yes_no    Boolean @default(false)
  budget_allocated String?
  approval_stage   String?

  authority_yes_no Boolean @default(false)
  decision_maker   String?

  need_yes_no      Boolean @default(false)
  pain_points_desc String? @db.Text

  timeline_yes_no       Boolean   @default(false)
  expected_closure_date DateTime?

  // Quadrant
  quadrant                  String? // Q1, Q2, Q3, Q4, Nurturing
  quadrant_updated_at       DateTime?
  quadrant_start_date       DateTime? @default(now())
  quadrant_changed_at       DateTime? // Set whenever quadrant changes; age = now() - this (or created_at if null)
  last_positive_movement_at DateTime? @default(now())
  order_won_at              DateTime? // Set exactly once, when sales_stage transitions to "Order Won"; never overwritten afterward — true achievement date for SEAL/reporting
  requires_requalification  Boolean   @default(false) // True after Nurturing or nightly auto-degradation resets score/BANT; cleared on next score+BANT recalculation

  // Follow up
  follow_up_activity_id Int?
  follow_up_datetime    DateTime?

  sales_stage_id         Int?
  next_activity_id       Int?
  next_activity_datetime DateTime?

  bant_focus_area String? // Budget / Authority / Need / Timeline

  is_farming       Boolean   @default(false)
  farming_moved_at DateTime?

  // Relations
  owner           User?       @relation("LeadOwner", fields: [lead_owner_id], references: [id])
  creator         User        @relation("LeadCreator", fields: [created_by_id], references: [id])
  company_master  Company?      @relation(fields: [company_id], references: [id])
  client_company  ClientCompany? @relation(fields: [client_company_id], references: [id])
  vertical        Vertical?      @relation(fields: [vertical_id], references: [id])
  sbu             SBU?        @relation(fields: [sales_sbu_id], references: [id])
  job_title       JobTitle?   @relation(fields: [job_title_id], references: [id])
  lead_source     LeadSource? @relation(fields: [lead_source_id], references: [id])
  industry        Industry?   @relation(fields: [industry_id], references: [id])
  country         Country?    @relation(fields: [country_id], references: [id])
  state           State?      @relation(fields: [state_id], references: [id])
  city            City?       @relation(fields: [city_id], references: [id])
  product         Product?    @relation(fields: [product_id], references: [id])
  eitService      EitService? @relation("LeadEitService", fields: [eit_service_id], references: [id])
  imService       ImService?  @relation("LeadImService", fields: [im_service_id], references: [id])
  persona         Persona?    @relation(fields: [persona_id], references: [id])
  avatar          Avatar?     @relation(fields: [avatar_id], references: [id])
  where_find_them LeadSource? @relation("LeadSourcing", fields: [where_find_them_id], references: [id])

  collaterals Collateral[]

  follow_up_activity Activity?   @relation("FollowUpActivity", fields: [follow_up_activity_id], references: [id])
  next_activity      Activity?   @relation("NextActivity", fields: [next_activity_id], references: [id])
  sales_stage        SalesStage? @relation(fields: [sales_stage_id], references: [id])

  contacts             LeadContact[]
  documents            LeadDocument[]
  calls                CallLog[]
  pricing_negotiations PricingNegotiationLog[]
  score_history        LeadScore[]
  follow_up_logs       FollowUpLog[]

  call_tracker_id  Int?                  @unique
  call_tracker     CallTracker?          @relation(fields: [call_tracker_id], references: [id])
  quadrant_history LeadQuadrantHistory[]

  weekly_report_details WeeklyReportDetail[]
  bant_answers          LeadBantAnswer[]

  source_enquiries Enquiry[] @relation("EnquiryConvertedLead")
  daily_report_leads DailyReportLead[]
  milestones     LeadMilestone[]
  milestone_payment_history  LeadMilestonePaymentHistory[]
  milestone_bant_poa_history LeadMilestoneBantPoaHistory[]
  forecast_header ForecastHeader?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Sales Engagement Date — dashboard Sales Activities cards + Lead Report filter
  @@index([follow_up_datetime], map: "idx_lead_follow_up_datetime")
  @@map("lead")
}

model LeadContact {
  id             Int     @id @default(autoincrement())
  lead_id        Int
  name           String?
  designation    String?
  email          String?
  contact_mobile String?
  whatsapp       String?
  avatar_id      Int?
  persona_id     Int?

  lead    Lead     @relation(fields: [lead_id], references: [id])
  avatar  Avatar?  @relation(fields: [avatar_id], references: [id])
  persona Persona? @relation(fields: [persona_id], references: [id])

  @@map("leadcontact")
}

model LeadDocument {
  id               Int      @id @default(autoincrement())
  lead_id          Int
  follow_up_log_id Int?
  name             String?
  url              String?
  description      String?
  uploaded_at      DateTime @default(now())

  lead          Lead         @relation(fields: [lead_id], references: [id])
  follow_up_log FollowUpLog? @relation(fields: [follow_up_log_id], references: [id])

  @@map("leaddocument")
}

model FollowUpLog {
  id               Int       @id @default(autoincrement())
  lead_id          Int
  activity_id      Int?
  sales_stage_id   Int? // Track which stage was active when this log was created
  next_activity_id Int? // New: Track what was set as next activity in this log
  date             DateTime?
  notes            String?   @db.Text
  status           String    @default("Pending") // Pending / In Progress / Completed
  created_at       DateTime  @default(now())
  created_by_id    Int

  lead          Lead           @relation(fields: [lead_id], references: [id])
  activity      Activity?      @relation("FollowUpActivityLog", fields: [activity_id], references: [id])
  next_activity Activity?      @relation("FollowUpNextActivity", fields: [next_activity_id], references: [id])
  sales_stage   SalesStage?    @relation(fields: [sales_stage_id], references: [id])
  creator       User           @relation(fields: [created_by_id], references: [id])
  documents     LeadDocument[]

  @@map("followuplog")
}

model LeadQuadrantHistory {
  id            Int          @id @default(autoincrement())
  lead_id       Int
  user_id       Int? // user who performed movement
  old_quadrant  String? // Q1, Q2, Q3, Q4, NURTURING, ORDER
  new_quadrant  String? // Q1, Q2, Q3, Q4, NURTURING, ORDER
  movement_type MovementType @default(MANUAL)
  trigger_days  Int?         // Days threshold that triggered AUTO movement
  moved_at      DateTime     @default(now())

  lead Lead @relation(fields: [lead_id], references: [id])

  @@index([user_id, moved_at])
  @@index([old_quadrant, new_quadrant])
  @@map("leadquadranthistory")
}

