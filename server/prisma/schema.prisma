  error_message  String?   @db.Text
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  company        Company?  @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@index([status])
  @@map("whatsapp_web_session")
}

model CronJobLock {
  id                Int      @id @default(autoincrement())
  job_name          String   @unique(map: "job_name") @db.VarChar(100)
  lock_owner        String   @db.VarChar(200)
  locked_at         DateTime @default(now())
  locked_until      DateTime
  last_heartbeat_at DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([job_name, locked_until])
  @@map("cron_job_lock")
}

model RenewalFollowUpTask {
  id                   Int       @id @default(autoincrement())
  renewal_account_id   Int
  service_instance_id  Int
  cycle_id             Int
  policy_version       Int?
  follow_up_group_key  String    @db.VarChar(50)
  scheduled_for        DateTime
  overall_status       String    @default("PENDING")
  assigned_user_id     Int?
  completed_at         DateTime?
  cancelled_at         DateTime?
  cancel_reason        String?   @db.VarChar(500)
  is_deleted           Boolean   @default(false)
  source_type          String    @default("POLICY_STEP")
  source_reference_id  Int?
  migration_confidence String?   @db.VarChar(20)
  source               String?   @db.VarChar(50)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  channel_actions      RenewalFollowUpChannelAction[]

  renewal_account      RenewalAccount          @relation(fields: [renewal_account_id], references: [id], onDelete: Restrict)
  service_instance     RenewalServiceInstance  @relation(fields: [service_instance_id], references: [id], onDelete: Restrict)
  cycle                RenewalCycle            @relation(fields: [cycle_id], references: [id], onDelete: Restrict)
  assigned_user        User?                   @relation("FollowUpTaskAssignee", fields: [assigned_user_id], references: [id])
  communication_events RenewalCommunicationEvent[]

  @@index([scheduled_for, overall_status])
  @@index([assigned_user_id, overall_status])
  @@index([cycle_id])
  @@index([policy_version])
  @@map("renewal_follow_up_task")
}

model RenewalFollowUpChannelAction {
  id                    Int       @id @default(autoincrement())
  follow_up_task_id     Int
  renewal_account_id    Int
  service_instance_id   Int
  cycle_id              Int
  reminder_id           Int?
  channel               String    @db.VarChar(20)
  action_type           String    @db.VarChar(30)
  execution_mode        String    @default("AUTOMATIC") @db.VarChar(30)
  communication_purpose String?   @db.VarChar(30)
  is_required           Boolean   @default(true)
  status                String    @default("PENDING")
  scheduled_at          DateTime?
  started_at            DateTime?
  completed_at          DateTime?
  recipient_contact_id  Int?
  recipient_address     String?   @db.VarChar(300)
  template_id           Int?
  idempotency_key       String    @unique(map: "idempotency_key") @db.VarChar(100)
  provider_message_id   String?   @db.VarChar(200)
  outcome_code          String?   @db.VarChar(50)
  customer_response     String?   @db.Text
  notes                 String?   @db.Text
  created_by_id         Int?
  completed_by_id       Int?
  is_deleted            Boolean   @default(false)
  digest_outbox_id      Int?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  follow_up_task        RenewalFollowUpTask @relation(fields: [follow_up_task_id], references: [id])
  renewal_account       RenewalAccount @relation(fields: [renewal_account_id], references: [id], onDelete: Restrict)
  service_instance      RenewalServiceInstance @relation(fields: [service_instance_id], references: [id], onDelete: Restrict)
  cycle                 RenewalCycle @relation(fields: [cycle_id], references: [id], onDelete: Restrict)
  reminder              RenewalReminder? @relation(fields: [reminder_id], references: [id])
  recipient_contact     RenewalContact? @relation(fields: [recipient_contact_id], references: [id])
  template              RenewalNotificationTemplate? @relation(fields: [template_id], references: [id])
  created_by            User? @relation("ChannelActionCreator", fields: [created_by_id], references: [id])
  completed_by          User? @relation("ChannelActionCompleter", fields: [completed_by_id], references: [id])
  outbox_messages       NotificationOutbox[] @relation("ChannelActionOutbox")
  communication_events  RenewalCommunicationEvent[]

  @@unique([follow_up_task_id, reminder_id])
  @@unique([follow_up_task_id, channel, action_type, execution_mode])
  @@index([follow_up_task_id, channel])
  @@index([status, scheduled_at])
  @@index([idempotency_key])
  @@map("renewal_follow_up_channel_action")
}

model RenewalCommunicationEvent {
  id                         Int      @id @default(autoincrement())
  renewal_account_id         Int
  service_instance_id        Int
  cycle_id                   Int
  follow_up_task_id          Int?
  channel_action_id          Int?
  reminder_id                Int?
  outbox_id                  Int?
  account_snapshot_id        Int?
  service_snapshot_id        Int?
  cycle_snapshot_id          Int?
  task_snapshot_id           Int?
  channel_action_snapshot_id Int?
  channel                    String   @db.VarChar(20)
  event_type                 String   @db.VarChar(30)
  execution_mode             String?  @db.VarChar(30)
  communication_purpose      String?  @db.VarChar(30)
  direction                  String   @default("OUTBOUND")
  status                     String
  actor_type                 String
  actor_user_id              Int?
  recipient                  String?  @db.VarChar(300)
  subject_snapshot           String?  @db.VarChar(500)
  body_snapshot              String?  @db.LongText
  attachment_metadata        String?  @db.LongText
  template_id                Int?
  template_version           String?  @db.VarChar(50)
  content_snapshot_ref       String?  @db.VarChar(500)
  provider_message_id        String?  @db.VarChar(200)
  error_code                 String?  @db.VarChar(100)
  error_message              String?  @db.Text
  metadata                   String?  @db.LongText
  occurred_at                DateTime @default(now())
  created_at                 DateTime @default(now())

  renewal_account   RenewalAccount @relation(fields: [renewal_account_id], references: [id], onDelete: Restrict)
  service_instance  RenewalServiceInstance @relation(fields: [service_instance_id], references: [id], onDelete: Restrict)
  cycle             RenewalCycle @relation(fields: [cycle_id], references: [id], onDelete: Restrict)
  follow_up_task    RenewalFollowUpTask? @relation(fields: [follow_up_task_id], references: [id], onDelete: Restrict)
  channel_action    RenewalFollowUpChannelAction? @relation(fields: [channel_action_id], references: [id], onDelete: Restrict)
  reminder          RenewalReminder? @relation(fields: [reminder_id], references: [id], onDelete: Restrict)
  outbox            NotificationOutbox? @relation("OutboxCommunicationEvent", fields: [outbox_id], references: [id], onDelete: SetNull)
  actor_user        User? @relation("CommunicationActor", fields: [actor_user_id], references: [id])

  @@index([renewal_account_id, occurred_at])
  @@index([service_instance_id, occurred_at])
  @@index([cycle_id, occurred_at])
  @@index([follow_up_task_id, occurred_at])
  @@index([channel_action_id, occurred_at])
  @@index([channel, occurred_at])
  @@map("renewal_communication_event")
}

