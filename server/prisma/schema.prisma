// Billing Forecast (VP screens, vpscreen.md) — management-facing forecast /
// invoice-tracking layer over Order Won lead milestones. A milestone is added
// here from the Billing Forecast Milestones screen (one row per milestone,
// enforced by the unique FK below so it can only be added once); it starts as
// "Forecast" and moves to "Achieved" the moment its invoice details are saved
// from the Billing Forecast Tracker. One-directional by design — no revert path.
model BillingForecast {
  id                     Int       @id @default(autoincrement())
  lead_milestone_id      Int       @unique
  added_by_id            Int?
  invoice_number         String?   @db.VarChar(100)
  invoice_date           DateTime?
  edc_payment_collection DateTime?
  status                 String    @default("Forecast") // Forecast | Achieved
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  lead_milestone LeadMilestone @relation(fields: [lead_milestone_id], references: [id], onDelete: Cascade)
  added_by       User?         @relation(fields: [added_by_id], references: [id])

  @@map("billing_forecast")
}

