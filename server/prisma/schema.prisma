  updated_at       DateTime             @default(now()) @updatedAt

  brand_profile    RenewalBrandProfile? @relation(fields: [brand_profile_id], references: [id])
  reminders        RenewalReminder[]
  channel_actions  RenewalFollowUpChannelAction[]

  @@index([brand_profile_id])
  @@map("renewal_notification_template")
}

model RenewalPayment {
  id              Int          @id @default(autoincrement())
  cycle_id        Int
  amount          Decimal      @db.Decimal(12, 2)
  payment_date    DateTime
  collected_by_id Int?
  payment_mode    String?      @db.VarChar(50)
  reference       String?      @db.VarChar(200)
  remarks         String?      @db.Text
  created_at      DateTime     @default(now())

  cycle           RenewalCycle @relation(fields: [cycle_id], references: [id], onDelete: Cascade)

  @@index([cycle_id])
  @@map("renewal_payment")
}

model RenewalPolicyVersion {
  id                      Int      @id @default(autoincrement())
  policy_id               Int
  version                 Int
  name_snapshot           String
  steps_snapshot          String   @db.Text
  change_summary          String?  @db.VarChar(500)
  changed_by_id           Int?
  change_reason           String?  @db.VarChar(500)
  affected_services_count Int      @default(0)
  created_at              DateTime @default(now())

  @@unique([policy_id, version])
  @@map("renewal_policy_version")
}

model RenewalProvider {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  category_code String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  service_instances RenewalServiceInstance[]

  @@map("renewal_provider")
}

model RenewalProviderSubItem {
  id          Int      @id @default(autoincrement())
  provider_id Int
  name        String
  type        String   @default("SERVER")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  @@index([provider_id])
  @@map("renewal_provider_sub_item")
}

model RenewalReminder {
  id                    Int       @id @default(autoincrement())
  cycle_id              Int
  step_number           Int
  offset_days           Int
  due_date              DateTime
  action_type           String
  channel               String
  recipient_type        String
  assigned_user_id      Int?
  template_id           Int?
  status                String    @default("PENDING")
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt
  completed_at          DateTime?
  completed_by_id       Int?
  skipped_at            DateTime?
  skip_reason           String?   @db.VarChar(500)
  policy_version        Int?
  is_mandatory          Boolean   @default(false)
  escalation_after_days Int?
  escalate_to_id        Int?
  escalated             Boolean             @default(false)
  escalated_at          DateTime?

  cycle                 RenewalCycle        @relation(fields: [cycle_id], references: [id], onDelete: Cascade)
  follow_up_logs        RenewalFollowUpLog[]
  assigned_user         User?               @relation("ReminderAssignee", fields: [assigned_user_id], references: [id])
  completed_by          User?               @relation("ReminderCompleter", fields: [completed_by_id], references: [id])
  template              RenewalNotificationTemplate? @relation(fields: [template_id], references: [id])
  channel_actions       RenewalFollowUpChannelAction[]
  communication_events  RenewalCommunicationEvent[]

  @@index([due_date, status])
  @@index([assigned_user_id, status])
  @@index([cycle_id])
  @@map("renewal_reminder")
}

model RenewalReminderPolicy {
  id                  Int                     @id @default(autoincrement())
  name                String
  company_id          Int?
  service_category_id Int?
  service_master_id   Int?
  is_default          Boolean                 @default(false)
  use_business_days   Boolean                 @default(false)
  skip_weekends       Boolean                 @default(false)
  timezone            String                  @default("Asia/Kolkata")
  version             Int                     @default(1)
  is_active           Boolean                 @default(true)
  created_at          DateTime                @default(now())
  updated_at          DateTime                @default(now()) @updatedAt

  category             RenewalServiceCategory? @relation(fields: [service_category_id], references: [id])
  service_masters      RenewalServiceMaster[]  @relation("PolicyForService")
  default_for_services RenewalServiceMaster[]  @relation("DefaultServicePolicy")
  service_instances    RenewalServiceInstance[]
  steps                RenewalReminderStep[]

  @@map("renewal_reminder_policy")
}

model RenewalReminderStep {
  id                  Int      @id @default(autoincrement())
  policy_id           Int
  step_number         Int
  offset_days         Int
  relative_to         String   @default("EXPIRY_DATE")
  action_type         String
  channel             String
  recipient_type      String
  template_id         Int?
  escalate_after_days Int?
  escalate_to         String?  @db.VarChar(100)
  is_mandatory        Boolean  @default(false)
  is_enabled          Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt
  attach_order_form   Boolean  @default(false)
  policy              RenewalReminderPolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@unique([policy_id, step_number])
  @@map("renewal_reminder_step")
}

model RenewalServiceCategory {
  id         Int      @id @default(autoincrement())
  name       String
  code       String
  color      String?  @default("#6366f1")
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  parent_id  Int?
  company_id Int?

  parent              RenewalServiceCategory?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children            RenewalServiceCategory[] @relation("CategoryHierarchy")
  company             Company?                  @relation(fields: [company_id], references: [id])
  services             RenewalServiceMaster[]   @relation("ServiceMasterCategory")
  sub_category_services RenewalServiceMaster[]  @relation("ServiceMasterSubCategory")
  policies             RenewalReminderPolicy[]

  @@index([company_id])
  @@index([company_id, name])
  @@unique([company_id, code])
  @@map("renewal_service_category")
}

model RenewalServiceInstance {
  id                  Int       @id @default(autoincrement())
  renewal_account_id  Int
  service_master_id   Int
  identifier          String?
  provider_id         Int?
  quantity            Int       @default(1)
  activation_date     DateTime?
  expiry_date         DateTime?
  actual_expiry_date  DateTime?
  duration_value      Int?      @default(12)
  duration_unit       String?   @default("months")
  amount_due          Decimal   @default(0.00) @db.Decimal(12, 2)
  amc_amount          Decimal   @default(0.00) @db.Decimal(12, 2)
  support_amount      Decimal   @default(0.00) @db.Decimal(12, 2)
  assigned_user_id    Int?
  customer_contact_id Int?
  reminder_policy_id  Int?
  override_policy     Boolean   @default(false)
  status              String    @default("ACTIVE")
  remarks             String?   @db.Text
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt
  email_count         Int?
  provider_type       String?
  server_name         String?
  plan_name           String?
  billing_term        String?   @default("Yearly")
  unit_price          Decimal?  @default(0.00) @db.Decimal(12, 2)
  login_username       String?   // New field for ANGLER requirement
  service_transaction_type String?  // REGISTRATION | RENEWAL - distinct from lifecycle status
  order_number             String?  @db.VarChar(100)
  order_date               DateTime?
  po_reference             String?  @db.VarChar(200)
  invoice_number           String?  @db.VarChar(100)
  invoice_date             DateTime?

  renewal_account      RenewalAccount          @relation(fields: [renewal_account_id], references: [id], onDelete: Cascade)
  service_master       RenewalServiceMaster    @relation(fields: [service_master_id], references: [id])
  provider             RenewalProvider?        @relation(fields: [provider_id], references: [id])
  customer_contact     RenewalContact?         @relation(fields: [customer_contact_id], references: [id])
  reminder_policy      RenewalReminderPolicy?  @relation(fields: [reminder_policy_id], references: [id])
  cycles               RenewalCycle[]
  follow_up_logs       RenewalFollowUpLog[]
  instance_alert_steps RenewalInstanceAlertStep[]

  assigned_user        User?                   @relation("ServiceAssignee", fields: [assigned_user_id], references: [id])
  follow_up_tasks      RenewalFollowUpTask[]
  channel_actions      RenewalFollowUpChannelAction[]
  communication_events RenewalCommunicationEvent[]

  @@index([renewal_account_id])
  @@index([order_number])
  @@index([expiry_date])
  @@index([status])
  @@index([assigned_user_id])
  @@map("renewal_service_instance")
}

model RenewalServiceMaster {
  id                         Int      @id @default(autoincrement())
  name                       String
  category_id                Int
  identifier_label           String?  @default("Identifier")
  requires_identifier        Boolean  @default(true)
  supports_provider          Boolean  @default(true)
  requires_provider          Boolean  @default(false)
  supports_server_name       Boolean  @default(true)
  requires_server_name       Boolean  @default(false)
  supports_plan_name         Boolean  @default(true)
  requires_plan_name         Boolean  @default(false)
  supports_login_username    Boolean  @default(false)
  requires_login_username    Boolean  @default(false)
  supports_quantity          Boolean  @default(false)
  requires_quantity          Boolean  @default(false)
  quantity_label             String?  // "No. of Email IDs", "No. of Vehicles", etc.
  default_duration_value     Int?     @default(12)
  default_duration_unit      String?  @default("months")
  supports_amc               Boolean  @default(false)
  supports_support_package   Boolean  @default(false)
  default_reminder_policy_id Int?
  is_active                  Boolean  @default(true)
  sort_order                 Int      @default(0)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @default(now()) @updatedAt
  sub_category_id            Int?
  company_id                 Int?

  company        Company?                 @relation(fields: [company_id], references: [id])
  category       RenewalServiceCategory  @relation("ServiceMasterCategory", fields: [category_id], references: [id])
  sub_category   RenewalServiceCategory? @relation("ServiceMasterSubCategory", fields: [sub_category_id], references: [id], onDelete: SetNull)
  default_policy RenewalReminderPolicy?  @relation("DefaultServicePolicy", fields: [default_reminder_policy_id], references: [id])
  instances      RenewalServiceInstance[]
  policies       RenewalReminderPolicy[] @relation("PolicyForService")
  default_prices RenewalServicePrice[]
  customer_prices RenewalCustomerPrice[]

  @@index([company_id])
  @@index([company_id, name])
  @@map("renewal_service_master")
}

model RenewalServicePlanMaster {
  id            Int      @id @default(autoincrement())
  name          String   @unique(map: "name")
  category_code String?  @default("SERVER")
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  @@map("renewal_service_plan_master")
}

model RenewalServicePrice {
  id                Int       @id @default(autoincrement())
  service_master_id Int
  base_price        Decimal   @default(0.00) @db.Decimal(12, 2)
  billing_unit      String    @default("year") @db.VarChar(20)
