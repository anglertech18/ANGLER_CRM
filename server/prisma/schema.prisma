generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator custom_client {
  provider      = "prisma-client-js"
  output        = "./v2-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int               @id @default(autoincrement())
  email                      String            @unique(map: "User_email_key")
  password_hash              String
  first_name                 String
  last_name                  String?
  role                       Role              @default(SalesPerson)
  status                     UserStatus        @default(INVITED)
  is_active                  Boolean           @default(true)
  joining_date               DateTime?
  revenue_target             Int?              @default(0)
  device_target              Int?              @default(0)
  leads_target               Int?              @default(0)
  calls_target               Int?              @default(0)
  activities_target          Int?              @default(0)
  q1_target                  Int?              @default(0)
  linkedin_target            Int?              @default(0)
  demo_target                Int?              @default(0)
  proposal_target            Int?              @default(0)
  direct_visit_target        Int?              @default(0)
  company_id                 Int?
  sbu_id                     Int?
  reporting_manager_id       Int?
  reset_token                String?
  reset_token_expiry         DateTime?
  department_id              Int?
  department                 String            @default("IM")
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @updatedAt
  cashflow_management_access Boolean           @default(false)
  cashflow_trackers          CashflowTracker[] @relation("CashflowExecutive")
  forecast_headers           ForecastHeader[]
  company                    Company?          @relation(fields: [company_id], references: [id])
  department_rel             Department?       @relation(fields: [department_id], references: [id])
  reporting_manager          User?             @relation("ReportingManager", fields: [reporting_manager_id], references: [id])
  subordinates               User[]            @relation("ReportingManager")
  sbu                        SBU?              @relation(fields: [sbu_id], references: [id])
  privileges                 Privilege[]
  cashflow_management_companies CashflowManagementCompany[]
  managed_companies          CashflowManagementCompany[] @relation("ManagedCompanies")
  managed_accounts           RenewalAccount[]  @relation("AccountManagerAccounts")
  executive_accounts         RenewalAccount[]  @relation("ExecutiveAccounts")
  call_trackers              CallTracker[]
  user_product_targets       UserProductTarget[]
  leads_owned                Lead[]            @relation("LeadOwner")
  leads_created              Lead[]            @relation("LeadCreatedBy")
  daily_reports              DailyReport[]
  partners                   Partner[]
  poas                       PlanOfAction[]
  weekly_reports             WeeklyReport[]
  created_follow_up_logs     FollowUpLog[]
  call_logs                  CallLog[]
  enquiries_created          Enquiry[]         @relation("EnquiryCreatedBy")
  enquiries_validated        Enquiry[]         @relation("EnquiryValidatedBy")
  enquiries_allocated        Enquiry[]         @relation("EnquiryAllocatedTo")
  enquiries_allocated_user   Enquiry[]         @relation("EnquiryAllocatedToUser")
  pricing_negotiations       LeadPricingNegotiation[]
  swat_performances          SwatPerformance[]
  call_activity_logs         CallActivityLog[]
  bulk_upload_stagings       BulkUploadStaging[]
  pricing_negotiation_logs   PricingNegotiationLog[]
  approved_outboxes          NotificationOutbox[]    @relation("NotificationApprovedBy")
  renewal_reminders_assigned RenewalReminder[]       @relation("ReminderAssignee")
  renewal_reminders_completed RenewalReminder[]      @relation("ReminderCompleter")
  renewal_follow_up_logs     RenewalFollowUpLog[]    @relation("FollowUpLogger")
  follow_up_tasks_assigned   RenewalFollowUpTask[]   @relation("FollowUpTaskAssignee")
  channel_actions_created    RenewalFollowUpChannelAction[] @relation("ChannelActionCreator")
  channel_actions_completed  RenewalFollowUpChannelAction[] @relation("ChannelActionCompleter")
  communication_events_performed RenewalCommunicationEvent[] @relation("CommunicationActor")
  renewal_service_assignments RenewalServiceInstance[] @relation("ServiceAssignee")
  renewal_audit_logs         RenewalAuditLog[]       @relation("AuditPerformer")

  @@index([company_id], map: "user_company_id_fkey")
  @@index([department_id], map: "user_department_id_fkey")
  @@index([reporting_manager_id], map: "user_reporting_manager_id_fkey")
  @@index([sbu_id], map: "user_sbu_id_fkey")
  @@map("user")
}

model Privilege {
  id          Int     @id @default(autoincrement())
  user_id     Int
  module_name String
  can_add     Boolean @default(false)
  can_edit    Boolean @default(false)
  can_delete  Boolean @default(false)
  can_view    Boolean @default(false)

  user        User    @relation(fields: [user_id], references: [id])

  @@unique([user_id, module_name], map: "Privilege_user_id_module_name_key")
  @@map("privilege")
}

model CashflowManagementCompany {
  id         Int      @id @default(autoincrement())
  user_id    Int
  company_id Int
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
  user_managed User?  @relation("ManagedCompanies", fields: [user_id], references: [id], map: "fk_managed_company_user")

  @@unique([user_id, company_id], map: "uniq_cashflow_mgmt_user_company")
  @@map("cashflow_management_company")
}

model Department {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "Department_name_key")
  is_active Boolean @default(true)
  users     User[]

  @@map("department")
}

model Company {
  id                     Int              @id @default(autoincrement())
  name                   String           @unique(map: "Company_name_key")
  is_active              Boolean          @default(true)
  report_recipient_email String?
  order_form_template_id Int?
  forecast_headers       ForecastHeader[]
  users                  User[]
  renewal_accounts       RenewalAccount[]
  renewal_service_categories RenewalServiceCategory[]
  renewal_service_masters RenewalServiceMaster[]
  products               Product[]
  daily_reports          DailyReport[]
  whatsapp_sessions      WhatsappWebSession[]

  @@map("company")
}

model SBU {
  id         Int     @id @default(autoincrement())
  name       String
  company_id Int
  is_active  Boolean @default(true)
  users      User[]
  leads      Lead[]

  @@map("sbu")
}

model JobTitle {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "JobTitle_name_key")
  is_active Boolean @default(true)
  leads     Lead[]

  @@map("jobtitle")
}

model LeadSource {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "LeadSource_name_key")
  is_active Boolean @default(true)

  leads         Lead[]
  call_trackers CallTracker[]
  partners      Partner[]
  enquiries     Enquiry[]

  @@map("leadsource")
}

model Industry {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "Industry_name_key")
  is_active Boolean @default(true)

  leads         Lead[]
  call_trackers CallTracker[]

  @@map("industry")
}

model Country {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "Country_name_key")
  is_active Boolean @default(true)

  leads     Lead[]
  enquiries Enquiry[]

  @@map("country")
}

model State {
  id         Int     @id @default(autoincrement())
  name       String
  country_id Int
  is_active  Boolean @default(true)

  leads      Lead[]
  enquiries  Enquiry[]

  @@map("state")
}

model City {
  id        Int     @id @default(autoincrement())
  name      String
  state_id  Int
  is_active Boolean @default(true)

  leads     Lead[]
  enquiries Enquiry[]

  @@map("city")
}

model Product {
  id                    Int               @id @default(autoincrement())
  name                  String            @unique(map: "Product_name_key")
  count_type            String?
  company_id            Int?
  is_active             Boolean           @default(true)
  q4_to_q3_days         Int               @default(0)
  q3_to_q2_days         Int               @default(0)
  q2_to_q1_days         Int               @default(0)
  q1_to_nurturing_days  Int               @default(0)
  device_q4_multiplier  Float             @default(1)
  device_q3_multiplier  Float             @default(1)
  device_q2_multiplier  Float             @default(1)
  device_q1_multiplier  Float             @default(1)
  lead_q4_multiplier    Float             @default(1)
  lead_q3_multiplier    Float             @default(1)
  lead_q2_multiplier    Float             @default(1)
  lead_q1_multiplier    Float             @default(1)
  lead_multiplier_count Float             @default(1)
  cashflow_trackers     CashflowTracker[]
  forecast_headers      ForecastHeader[]
  company               Company?          @relation(fields: [company_id], references: [id])
  leads                 Lead[]
  user_targets          UserProductTarget[]
  call_trackers         CallTracker[]
  poas                  PlanOfAction[]
  enquiries             Enquiry[]
  swat_performances     SwatPerformance[]

  @@index([company_id], map: "idx_product_company_id")
  @@map("product")
}

model EitService {
  id                 Int     @id @default(autoincrement())
  name               String  @unique(map: "EitService_name_key")
  count_type         String?
  is_active          Boolean @default(true)
  lead_q1_multiplier Float   @default(1)

  leads              Lead[]

  @@map("eitservice")
}

model ImService {
  id                 Int     @id @default(autoincrement())
  name               String  @unique(map: "ImService_name_key")
  count_type         String?
  is_active          Boolean @default(true)
  lead_q1_multiplier Float   @default(1)

  leads_im           Lead[]  @relation("LeadImService")

  @@map("imservice")
}

model Persona {
  id                 Int     @id @default(autoincrement())
  name               String
  product_id         Int?
  is_active          Boolean @default(true)
  eit_service_id     Int?
  im_service_id      Int?
  product_or_service String?

  leads              Lead[]

  @@map("persona")
}

model Collateral {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "Collateral_name_key")
  url       String?
  is_active Boolean @default(true)

  leads     Lead[]

  @@map("collateral")
}

model SalesStage {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "SalesStage_name_key")
  is_active Boolean @default(true)

  leads          Lead[]
  follow_up_logs FollowUpLog[]
  enquiries      Enquiry[]

  @@map("salesstage")
}

model UserProductTarget {
  id                         Int      @id @default(autoincrement())
  user_id                    Int
  product_id                 Int
  sales_target               Int?     @default(0)
  revenue_target             Int?     @default(0)
  device_target              Int?     @default(0)
  leads_target               Int?     @default(0)
  calls_target               Int?     @default(0)
  linkedin_target            Int?     @default(0)
  direct_visit_target        Int?     @default(0)
  email_target               Int?     @default(0)
  linkedin_connection_target Int?     @default(0)
  proposals_target           Int?     @default(0)
  demos_target               Int?     @default(0)
  partner_target             Int?     @default(0)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt
  days                       Int?     @default(0)

  user                       User     @relation(fields: [user_id], references: [id])
  product                    Product  @relation(fields: [product_id], references: [id])

  @@unique([user_id, product_id], map: "UserProductTarget_user_id_product_id_key")
  @@map("userproducttarget")
}

model Activity {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "Activity_name_key")
  is_active Boolean @default(true)

  follow_up_logs  FollowUpLog[]
  leads_next      Lead[]        @relation("LeadNextActivity")
  follow_up_next  FollowUpLog[] @relation("FollowUpLogNextActivity")
  leads_follow_up Lead[]        @relation("LeadFollowUpActivity")

  @@map("activity")
}

model Avatar {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "Avatar_name_key")
  is_active Boolean @default(true)

  contacts  LeadContact[]
  leads     Lead[]

  @@map("avatar")
}

model Lead {
  id                                       Int             @id @default(autoincrement())
  created_by_id                            Int
  sales_sbu_id                             Int?
  lead_owner_id                            Int?
  salutation                               Salutation?
  first_name                               String?
  last_name                                String?
  company_id                               Int?
  job_title_id                             Int?
  avatar_id                                Int?
  lead_source_id                           Int?
  industry_id                              Int?
  address                                  String?         @db.Text
  country_id                               Int?
  state_id                                 Int?
  city_id                                  Int?
  pin_code                                 String?
  other_info                               String?         @db.Text
  annual_turnover                          Decimal?
  mobile_number                            String?
  whatsapp_number                          String?
  email                                    String?
  website                                  String?
  product_or_service                       String?
  product_id                               Int?
  project_name                             String?         @db.VarChar(255)
  eit_service_id                           Int?
  im_service_id                            Int?
  persona_id                               Int?
  where_find_them_id                       Int?
  telecalling_qualified                    Boolean         @default(false)
  device_count                             String?
  employee_count                           String?
  vendor_count                             String?
  branch_unit                              String?
  license_count                            String?
  custom_count_type                        String?
  requirement_desc                         String?         @db.Text
  pain_points                              String?         @db.Text
  pain_points_files                        String?         @db.Text
  demo_completed                           Boolean         @default(false)
  pilot_provided                           Boolean         @default(false)
  demo_done_authority                      Boolean         @default(false)
  post_demo_feedback_sent                  Boolean         @default(false)
  post_demo_feedback_received              Boolean         @default(false)
  post_demo_feedback_file                  String?
  probing_discussion_authority             Boolean         @default(false)
  direct_visit_authority                   Boolean         @default(false)
  pilot_given                              Boolean         @default(false)
  mgmt_call_completed                      Boolean         @default(false)
  utilized_mgmt_urgency                    Boolean         @default(false)
  utilized_presales_timeline               Boolean         @default(false)
  authority_champion_influencer_identified Boolean         @default(false)
  competitor_details                       String?         @db.Text
  opportunities_values                     String?         @db.Text
  order_won_attachment                     String?
  order_value                              Decimal?
  lead_score                               Int             @default(0)
  reduce_cost_score                        Int             @default(0)
  efficiency_score                         Int             @default(0)
  automation_score                         Int             @default(0)
  others_score                             Int             @default(0)
  others_score_label                       String?
  established_need_score                   Int             @default(0)
  urgency_score                            Int             @default(0)
  budget_allocated_score                   Int             @default(0)
  decision_maker_score                     Int             @default(0)
  competition_score                        Int             @default(0)
  champion_score                           Int             @default(0)
  influencer_score                         Int             @default(0)
  lead_source_quality                      Int             @default(0)
  decision_contact_score                   Int             @default(0)
  budget_yes_no                            Boolean         @default(false)
  budget_allocated                         String?
  approval_stage                           String?
  authority_yes_no                         Boolean         @default(false)
  decision_maker                           String?
  need_yes_no                              Boolean         @default(false)
  pain_points_desc                         String?         @db.Text
  timeline_yes_no                          Boolean         @default(false)
  expected_closure_date                    DateTime?
  quadrant                                 String?
  quadrant_updated_at                      DateTime?
  quadrant_start_date                      DateTime?       @default(now())
  last_positive_movement_at                DateTime?       @default(now())
  follow_up_activity_id                    Int?
  follow_up_datetime                       DateTime?
  sales_stage_id                           Int?
  next_activity_id                         Int?
  next_activity_datetime                   DateTime?
  is_farming                               Boolean         @default(false)
  farming_moved_at                         DateTime?
  call_tracker_id                          Int?            @unique(map: "Lead_call_tracker_id_key")
  created_at                               DateTime        @default(now())
  updated_at                               DateTime        @updatedAt
  compliance_score                         Int             @default(0)
  cp_score                                 Int             @default(0)
  company_name                             String?
  sales_device                             Int?
  quadrant_changed_at                      DateTime?
  enquiry_date                             DateTime?
  bant_focus_area                          String?
  client_company_id                        Int?
  vertical_id                              Int?
  requires_requalification                 Boolean         @default(false)
  order_won_at                             DateTime?
  forecast_header                          ForecastHeader?
  milestones                               LeadMilestone[]
  product                                  Product?        @relation(fields: [product_id], references: [id])
  sales_stage                              SalesStage?     @relation(fields: [sales_stage_id], references: [id])
  industry                                 Industry?       @relation(fields: [industry_id], references: [id])
  company_master                           ClientCompany?  @relation("LeadCompanyMaster", fields: [client_company_id], references: [id])
  owner                                    User?           @relation("LeadOwner", fields: [lead_owner_id], references: [id])
  created_by                               User            @relation("LeadCreatedBy", fields: [created_by_id], references: [id])
  contacts                                 LeadContact[]
  follow_up_logs                           FollowUpLog[]
  call_tracker                             CallTracker?    @relation(fields: [call_tracker_id], references: [id])
  milestone_payment_histories              LeadMilestonePaymentHistory[]
  weekly_report_details                    WeeklyReportDetail[]
  next_activity                            Activity?       @relation("LeadNextActivity", fields: [next_activity_id], references: [id])
  eitService                               EitService?     @relation(fields: [eit_service_id], references: [id])
  imService                                ImService?      @relation("LeadImService", fields: [im_service_id], references: [id])
  collaterals                              Collateral[]
  country                                  Country?        @relation(fields: [country_id], references: [id])
  state                                    State?          @relation(fields: [state_id], references: [id])
  city                                     City?           @relation(fields: [city_id], references: [id])
  documents                                LeadDocument[]
  calls                                    CallLog[]
  score_history                            LeadScore[]
  quadrant_history                         LeadQuadrantHistory[]
  job_title                                JobTitle?       @relation(fields: [job_title_id], references: [id])
  lead_source                              LeadSource?     @relation(fields: [lead_source_id], references: [id])
  sbu                                      SBU?            @relation(fields: [sales_sbu_id], references: [id])
  persona                                  Persona?        @relation(fields: [persona_id], references: [id])
  pricing_negotiations                     LeadPricingNegotiation[]
  avatar                                   Avatar?         @relation(fields: [avatar_id], references: [id])
  follow_up_activity                       Activity?       @relation("LeadFollowUpActivity", fields: [follow_up_activity_id], references: [id])
  where_find_them                          WhereFindThem?  @relation(fields: [where_find_them_id], references: [id])
  bant_answers                             LeadBantAnswer[]

  @@index([vertical_id], map: "idx_lead_vertical_id")
  @@map("lead")
}

model WhereFindThem {
  id        Int     @id @default(autoincrement())
  name      String  @unique(map: "WhereFindThem_name_key")
  is_active Boolean @default(true)

  leads     Lead[]

  @@map("wherefindthem")
}

model LeadContact {
  id             Int     @id @default(autoincrement())
  lead_id        Int
  name           String?
  designation    String?
  email          String?
  contact_mobile String?
  whatsapp       String?
  avatar_id      Int?
  persona_id     Int?

  lead           Lead    @relation(fields: [lead_id], references: [id])
  avatar         Avatar? @relation(fields: [avatar_id], references: [id])

  @@map("leadcontact")
}

model LeadDocument {
  id               Int          @id @default(autoincrement())
  lead_id          Int
  follow_up_log_id Int?
  name             String?
  url              String?
  description      String?
  uploaded_at      DateTime     @default(now())

  lead             Lead         @relation(fields: [lead_id], references: [id])
  follow_up_log    FollowUpLog? @relation(fields: [follow_up_log_id], references: [id])

  @@map("leaddocument")
}

model FollowUpLog {
  id               Int            @id @default(autoincrement())
  lead_id          Int
  activity_id      Int?
  date             DateTime?
  notes            String?        @db.Text
  created_at       DateTime       @default(now())
  created_by_id    Int
  sales_stage_id   Int?
  next_activity_id Int?

  lead             Lead           @relation(fields: [lead_id], references: [id])
  activity         Activity?      @relation(fields: [activity_id], references: [id])
  creator          User           @relation(fields: [created_by_id], references: [id])
  next_activity    Activity?      @relation("FollowUpLogNextActivity", fields: [next_activity_id], references: [id])
  sales_stage      SalesStage?    @relation(fields: [sales_stage_id], references: [id])
  documents        LeadDocument[]

  @@map("followuplog")
}

model LeadQuadrantHistory {
  id            Int          @id @default(autoincrement())
  lead_id       Int
  user_id       Int?
  old_quadrant  String?
  new_quadrant  String?
  movement_type MovementType @default(MANUAL)
  moved_at      DateTime     @default(now())
  trigger_days  Int?

  lead          Lead         @relation(fields: [lead_id], references: [id])

  @@index([old_quadrant, new_quadrant], map: "LeadQuadrantHistory_old_quadrant_new_quadrant_idx")
  @@index([user_id, moved_at], map: "LeadQuadrantHistory_user_id_moved_at_idx")
  @@map("leadquadranthistory")
}

model LeadScore {
  id         Int      @id @default(autoincrement())
  lead_id    Int
  score      Int
  breakdown  String?  @db.Text
  updated_by Int
  updated_at DateTime @default(now())

  lead       Lead     @relation(fields: [lead_id], references: [id])

  @@map("leadscore")
}

model LeadPricingNegotiation {
  id            Int      @id @default(autoincrement())
  lead_id       Int
  user_id       Int
  offered_price Decimal? @db.Decimal(15, 2)
  remarks       String?  @db.Text
  created_at    DateTime @default(now())

  lead          Lead     @relation(fields: [lead_id], references: [id])
  user          User     @relation(fields: [user_id], references: [id])

  @@map("leadpricingnegotiation")
}

model CallLog {
  id            Int       @id @default(autoincrement())
  lead_id       Int
  user_id       Int
  start_time    DateTime
  end_time      DateTime?
  duration_sec  Int?
  outcome       String?
  notes         String?   @db.Text
  recording_url String?
  bant_snapshot String?   @db.Text
  created_at    DateTime  @default(now())

  lead          Lead      @relation(fields: [lead_id], references: [id])
  user          User      @relation(fields: [user_id], references: [id])

  @@map("calllog")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String
  status     String   @default("Sent")
  notes      String?  @db.Text
  created_at DateTime @default(now())

  @@index([user_id, created_at], map: "ActivityLog_user_id_created_at_idx")
  @@map("activitylog")
}

model CallActivityLog {
  id          Int        @id @default(autoincrement())
  call_id     Int
  user_id     Int
  action_type CallAction
  action_date DateTime   @default(now())
  created_at  DateTime   @default(now())

  user        User       @relation(fields: [user_id], references: [id])

  @@index([user_id, action_date], map: "CallActivityLog_user_id_action_date_idx")
  @@map("callactivitylog")
}

model SwatKeyClosure {
  id                  Int             @id @default(autoincrement())
  swat_performance_id Int
  closure_text        String          @db.Text
  created_at          DateTime        @default(now())

  swat_performance    SwatPerformance @relation(fields: [swat_performance_id], references: [id])

  @@map("swatkeyclosure")
}

model KraEntry {
  id           Int      @id @default(autoincrement())
  user_id      Int
  date         DateTime @db.Date
  calls_target Int
  calls_actual Int
  notes        String?

  @@map("kraentry")
}

model PomodoroSession {
  id           Int       @id @default(autoincrement())
  user_id      Int
  start_time   DateTime
  end_time     DateTime?
  duration_sec Int?

  @@map("pomodorosession")
}

model PricingNegotiationLog {
  id         Int      @id @default(autoincrement())
  lead_id    Int
  date       DateTime @default(now())
  details    String?  @db.Text
  created_by Int

