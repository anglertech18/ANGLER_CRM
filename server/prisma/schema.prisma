  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(10)
  name       String   @db.VarChar(100)
  status     String   @default("active") @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  questions BantQuestion[]
  answers   LeadBantAnswer[]

  @@map("bantcategory")
}

model BantQuestion {
  id          Int      @id @default(autoincrement())
  category_id Int
  question    String   @db.Text
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  category BantCategory     @relation(fields: [category_id], references: [id])
  answers  LeadBantAnswer[]

  @@map("bantquestion")
}

model LeadBantAnswer {
  id          Int      @id @default(autoincrement())
  lead_id     Int
  category_id Int
  question_id Int
  answer      String?  @db.Text
  created_by  Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  lead     Lead         @relation(fields: [lead_id], references: [id])
  category BantCategory @relation(fields: [category_id], references: [id])
  question BantQuestion @relation(fields: [question_id], references: [id])
  creator  User?        @relation(fields: [created_by], references: [id])

  @@unique([lead_id, question_id])
  @@map("leadbantanswer")
}

model DailyReport {
  id              Int       @id @default(autoincrement())
  report_date     DateTime  @db.Date
  user_id         Int
  company_id      Int
  recipient_email String
  subject         String
  email_html      String    @db.LongText
  status          String    @default("generated") // "generated" | "sent" | "failed"
  error_message   String?   @db.Text
  sent_at         DateTime?
  created_at      DateTime  @default(now())

  user     User                 @relation("DailyReportUser", fields: [user_id], references: [id])
  company  Company              @relation(fields: [company_id], references: [id])
  products DailyReportProduct[]

  // One report row per user, per business date, per company — a BDE whose
  // products map to multiple companies gets one row (and one email) per company.
  @@unique([user_id, report_date, company_id])
  @@map("dailyreport")
}

model DailyReportProduct {
  id              Int    @id @default(autoincrement())
  daily_report_id Int
  product_id      Int
  product_name    String

  daily_report DailyReport             @relation(fields: [daily_report_id], references: [id], onDelete: Cascade)
  product      Product                 @relation(fields: [product_id], references: [id])
  leads        DailyReportLead[]
  swat_metrics DailyReportSwatMetric[]

  @@map("dailyreportproduct")
}

model DailyReportLead {
  id                       Int     @id @default(autoincrement())
  daily_report_product_id Int
  lead_id                 Int?
  lead_name               String
  quadrant                String?
  follow_up_notes         String  @db.Text
  status                   String? @db.VarChar(20)

  daily_report_product DailyReportProduct @relation(fields: [daily_report_product_id], references: [id], onDelete: Cascade)
  lead                 Lead?              @relation(fields: [lead_id], references: [id])

  @@map("dailyreportlead")
}

model DailyReportSwatMetric {
  id                       Int    @id @default(autoincrement())
  daily_report_product_id Int
  category                 String
  target                   Int    @default(0)
  achieved                 Int    @default(0)

  daily_report_product DailyReportProduct @relation(fields: [daily_report_product_id], references: [id], onDelete: Cascade)

  @@map("dailyreportswatmetric")
}
