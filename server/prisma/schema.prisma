  is_current        Boolean   @default(true)
  notes             String?   @db.Text
  created_by_id     Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  service_master RenewalServiceMaster @relation(fields: [service_master_id], references: [id])

  @@index([service_master_id, is_current])
  @@map("renewal_service_price")
}

model RenewalTemplateVersion {
